# ============================================================
#  backend/.dockerignore
#  Docker 이미지 빌드 시 컨텍스트에서 제외할 파일/폴더
#  (이미지 용량 절감 + 민감정보 유출 방지)
# ============================================================

# ── 파이썬 캐시/컴파일 산출물 ───────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── 가상환경 ────────────────────────────────────────────
.venv/
venv/
env/

# ── 버전 관리 ───────────────────────────────────────────
.git/
.gitignore

# ── 민감 정보 (이미지에 절대 포함 금지) ─────────────────
.env
.env.*
*.pem
*.key

# ── 로컬 데이터베이스 파일 ──────────────────────────────
#  컨테이너 시작 시 init_db() 가 테이블을 새로 생성하므로 제외합니다.
#  (운영 데이터는 Bind Mount/볼륨으로 별도 관리)
*.db
*.sqlite
*.sqlite3
movies.db

# ── 에디터/OS 부산물 ────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 문서/기타 (백엔드 이미지에 불필요) ──────────────────
README.md
*.md

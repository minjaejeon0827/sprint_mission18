# ============================================================
#  프로젝트 루트 .gitignore
# ============================================================

# ── 환경변수 (민감정보) ─────────────────────────────────
#  실제 값이 담긴 .env 는 절대 커밋 금지. .env.example 만 커밋합니다.
.env
.env.*
!.env.example

# ── 파이썬 ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/

# ── 데이터베이스 (로컬 데이터) ──────────────────────────
*.db
*.sqlite
*.sqlite3

# ── Streamlit 시크릿 ────────────────────────────────────
.streamlit/secrets.toml
frontend/.streamlit/secrets.toml

# ── 에디터 / OS ─────────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

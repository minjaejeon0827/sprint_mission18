# ============================================================
#  frontend/.dockerignore
#  Docker 이미지 빌드 시 컨텍스트에서 제외할 파일/폴더
# ============================================================
#  ※ Streamlit Cloud 배포 시에는 Dockerfile 을 쓰지 않으므로
#    이 파일이 사용되지 않습니다. (로컬/compose 빌드용)

# ── 파이썬 캐시 ─────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class

# ── 가상환경 ────────────────────────────────────────────
.venv/
venv/
env/

# ── 버전 관리 ───────────────────────────────────────────
.git/
.gitignore

# ── 민감 정보 (Streamlit secrets 는 이미지에 굽지 않음) ──
#  실제 secrets.toml 은 절대 이미지에 포함하지 않습니다.
#  (배포 시 Streamlit Cloud 대시보드의 Secrets 로 주입)
.streamlit/secrets.toml
.env
.env.*

# ── 에디터/OS 부산물 ────────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

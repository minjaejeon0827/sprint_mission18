# ============================================================
#  .env.example  —  환경변수 예시 파일
# ============================================================
#  [사용 방법]
#    1) 이 파일을 .env 라는 이름으로 복사합니다.
#         cp .env.example .env
#    2) 아래 값들을 실제 환경에 맞게 수정합니다.
#    3) docker compose 는 같은 폴더의 .env 를 자동으로 읽어
#       ${변수명} 형태로 치환합니다.
#
#  [주의]
#    ⚠️ 실제 .env 파일은 절대 Git 에 커밋하지 마세요.
#       (민감한 API 키가 그대로 노출됩니다. .gitignore 에 .env 포함)
#    ⚠️ 백엔드 이미지에도 굽지 마세요.
#       (.dockerignore 에 .env 가 포함되어 있습니다.)
# ============================================================


# ############################################################
#  ★ 꼭 읽어주세요 : API_KEYS 와 API_KEY 의 관계 ★
# ############################################################
#  둘은 "이름은 비슷하지만 역할이 반대"인, 인증의 양쪽 끝입니다.
#  (자물쇠 ↔ 열쇠 관계로 이해하시면 쉽습니다.)
#
#    • 백엔드  API_KEYS (복수형) = 자물쇠.
#        "이 키들만 통과시킨다"는 허용 목록. 쉼표로 여러 개 등록 가능.
#        → auth.py 가 요청 헤더의 키가 이 목록에 있는지 검사합니다.
#
#    • 프론트  API_KEY  (단수형) = 열쇠.
#        백엔드에 요청할 때 X-API-Key 헤더에 담아 보내는 "제출용 키" 1개.
#        → streamlit_app.py 가 이 값을 헤더에 실어 백엔드를 호출합니다.
#
#  [핵심 규칙]
#    프론트의 API_KEY 값은 반드시 백엔드 API_KEYS 목록 안에 들어있어야
#    인증이 통과됩니다. (열쇠가 자물쇠에 맞아야 문이 열리는 것과 같음)
#
#  [왜 하나로 합치지 않나요?]
#    - 백엔드와 프론트는 서로 다른 서버(GCP · Streamlit Cloud)에서 실행되어
#      변수를 물리적으로 공유할 수 없습니다.
#    - 백엔드는 키를 "여러 개" 허용할 수 있고(웹/앱/파트너별),
#      프론트는 그중 자기 키 "하나"만 제출합니다. (개수가 다름)
#    - 그래서 이름을 분리하는 것이 정상이며, 값만 일치시키면 됩니다.
#
#  [로컬에서 .env 없이 직접 실행하는 경우]  ※ 헷갈리기 쉬운 부분!
#    이 프로젝트 코드는 python-dotenv 를 쓰지 않으므로, uvicorn/streamlit 을
#    직접 실행하면 .env 가 "자동으로" 읽히지 않습니다. 이때는 아래처럼
#    실행 창(터미널)에서 환경변수를 직접 지정하되, 두 값을 똑같이 맞춰야 합니다.
#
#      # 터미널 1 — 백엔드 (자물쇠에 키 등록)
#      cd backend
#      API_KEYS=my-secret-key-12345 uvicorn main:app --port 8000
#
#      # 터미널 2 — 프론트 (같은 키를 열쇠로 제출)
#      cd frontend
#      API_KEY=my-secret-key-12345 BACKEND_URL=http://localhost:8000 \
#        streamlit run streamlit_app.py
#
#    ↑ 두 줄의 키 값(my-secret-key-12345)이 서로 같아야 인증이 통과됩니다.
#      만약 환경변수를 아예 지정하지 않아도, 양쪽 코드의 기본값이
#      동일하게 my-secret-key-12345 로 맞춰져 있어 로컬에서는 바로 동작합니다.
#
#  [docker compose 로 실행하는 경우]  ※ 이때는 한 곳만 고치면 됩니다!
#    docker-compose.yml 이 백엔드 API_KEYS 와 프론트 API_KEY 양쪽 모두를
#    아래 API_KEYS 한 값으로 주입하도록 설정되어 있습니다.
#    따라서 .env 의 API_KEYS 한 줄만 바꾸면 양쪽에 동시에 반영됩니다.
# ############################################################


# ────────────────────────────────────────────────────────────
#  [ 백엔드 (FastAPI) 환경변수 ]
# ────────────────────────────────────────────────────────────

# 【자물쇠】 API 키 허용 목록 — 쉼표로 여러 개 지정 가능
#   예) API_KEYS=web-key-abc,mobile-key-def,partner-key-xyz
#   ⚠️ 실제 배포 시에는 반드시 추측 불가능한 값으로 교체하세요.
#   ⚠️ 아래 프론트엔드 API_KEY 는 이 목록 안의 값 중 하나여야 합니다.
#   (auth.py 에서 사용)
API_KEYS=my-secret-key-12345

# CORS 허용 출처 — 쉼표로 여러 개 지정 가능
#   개발:  * (모든 출처 허용)
#   배포:  https://내앱이름.streamlit.app  (실제 프론트엔드 주소만 허용 권장)
#   (main.py 에서 사용)
CORS_ORIGINS=*

# SQLite 데이터베이스 파일 경로
#   비워두면 backend 폴더의 movies.db 를 사용합니다.
#   (database.py 에서 사용)
DB_PATH=movies.db

# 감성 분석 ML 모델 사용 여부
#   1 : Transformers 모델 사용(기본)   /   0 : 규칙 기반만 사용(모델 다운로드 안 함)
#   저사양/오프라인 서버라면 0 을 권장합니다.
#   (sentiment.py 에서 사용)
USE_ML_MODEL=1

# 사용할 한국어 감성 분석 모델 (Hugging Face 모델 이름)
#   기본값은 KcELECTRA 기반 경량 모델입니다.
#   (sentiment.py 에서 사용 · USE_ML_MODEL=1 일 때만 의미 있음)
SENTIMENT_MODEL=matthewburke/korean_sentiment


# ────────────────────────────────────────────────────────────
#  [ 프론트엔드 (Streamlit) 환경변수 ]
# ────────────────────────────────────────────────────────────
#  ※ Streamlit Cloud 배포 시에는 .env 대신
#    .streamlit/secrets.toml (또는 대시보드 Secrets)을 사용하세요.
#    로컬/docker-compose 실행 시에는 아래 환경변수가 사용됩니다.

# 백엔드(FastAPI) 주소
#   로컬 직접 실행:      http://localhost:8000
#   docker-compose:      http://backend:8000  (서비스 이름이 곧 호스트명)
#   GCP 배포 후:         https://<배포된-백엔드-주소>
#   (streamlit_app.py 에서 사용)
BACKEND_URL=http://localhost:8000

# 【열쇠】 백엔드 호출용 API 키 (딱 1개)
#   ⚠️ 위 백엔드 API_KEYS 목록에 들어있는 값과 반드시 일치해야 합니다.
#      (일치하지 않으면 백엔드가 403 으로 요청을 거부합니다.)
#   (streamlit_app.py 에서 사용)
API_KEY=my-secret-key-12345
